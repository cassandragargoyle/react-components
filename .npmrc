; Publish/resolve the @cassandragargoyle scope from GitHub Packages.
; The token is read from the environment (never commit it) — export a GitHub
; token before publishing:  export NODE_AUTH_TOKEN=<github-token-with-write:packages>
@cassandragargoyle:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
