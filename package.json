{
  "name": "@cassandragargoyle/react-components",
  "version": "0.3.1",
  "description": "Reusable, extensible React components shared across the CassandraGargoyle ecosystem",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "components",
    "typescript",
    "block-editor",
    "vscode-webview",
    "cassandragargoyle",
    "graph",
    "code-editor"
  ],
  "homepage": "https://github.com/cassandragargoyle/react-components#readme",
  "bugs": {
    "url": "https://github.com/cassandragargoyle/react-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cassandragargoyle/react-components.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "3d-force-graph": "^1.80.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/cytoscape": "^3.21.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@xyflow/react": "^12.11.2",
    "ag-grid-community": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "jsdom": "^25.0.1",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ag-grid-community": "^35.2.0",
    "ag-grid-react": "^35.2.0",
    "@xyflow/react": "^12.11.0",
    "3d-force-graph": "^1.80.0",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "monaco-editor": "^0.55.0"
  },
  "peerDependenciesMeta": {
    "ag-grid-community": {
      "optional": true
    },
    "ag-grid-react": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    },
    "3d-force-graph": {
      "optional": true
    },
    "cytoscape": {
      "optional": true
    },
    "cytoscape-dagre": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  }
}
